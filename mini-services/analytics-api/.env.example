APP_NAME="JobPilot Analytics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8002

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# This service is stateless: it computes every aggregate from an internal,
# deterministic mock dataset, so no database is required. The values below
# are placeholders for a future deployment against the shared JobPilot DB.
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Default port used by: php artisan serve --port=8002
APP_PORT=8002
